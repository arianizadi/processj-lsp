{
  "name": "processj-lsp-vscode",
  "displayName": "ProcessJ",
  "description": "ProcessJ language support with causal concurrency diagnostics, graphs, protocol and effect analysis, safe refactors, formatting, navigation and run-from-editor; the process graph and FDR checks for CSPm (.csp) files too.",
  "version": "0.1.5",
  "publisher": "arianizadi",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/arianizadi/processj-lsp"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:processj",
    "onLanguage:cspm",
    "onCommand:processj.runCurrentFile",
    "onCommand:processj.buildCurrentFile",
    "onCommand:processj.showConcurrencyGraph",
    "onCommand:processj.exportConcurrencyGraphFiles",
    "onCommand:processj.showProtocolFlow",
    "onCommand:processj.showProcedureEffects",
    "onCommand:processj.convertCurrentFileToCsp",
    "onCommand:processj.checkCurrentFileWithFdr",
    "onCommand:processj.restartServer",
    "onCommand:processj.showOutput"
  ],
  "contributes": {
    "languages": [
      {
        "id": "processj",
        "aliases": [
          "ProcessJ",
          "processj"
        ],
        "extensions": [
          ".pj"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "cspm",
        "aliases": [
          "CSPm",
          "cspm"
        ],
        "extensions": [
          ".csp"
        ],
        "configuration": "./cspm-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "processj",
        "scopeName": "source.processj",
        "path": "./syntaxes/processj.tmLanguage.json"
      },
      {
        "language": "cspm",
        "scopeName": "source.cspm",
        "path": "./syntaxes/cspm.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "processj.runCurrentFile",
        "title": "Run Current File",
        "category": "ProcessJ",
        "icon": "$(play)",
        "enablement": "editorLangId == processj"
      },
      {
        "command": "processj.buildCurrentFile",
        "title": "Build Current File",
        "category": "ProcessJ",
        "icon": "$(tools)",
        "enablement": "editorLangId == processj"
      },
      {
        "command": "processj.showConcurrencyGraph",
        "title": "Show Concurrency Graph",
        "category": "ProcessJ",
        "icon": "$(type-hierarchy)",
        "enablement": "editorLangId == processj || editorLangId == cspm"
      },
      {
        "command": "processj.exportConcurrencyGraphFiles",
        "title": "Export Concurrency Graph",
        "category": "ProcessJ",
        "icon": "$(export)",
        "enablement": "editorLangId == processj || editorLangId == cspm"
      },
      {
        "command": "processj.showProtocolFlow",
        "title": "Show Protocol Flow",
        "category": "ProcessJ",
        "icon": "$(git-merge)",
        "enablement": "editorLangId == processj"
      },
      {
        "command": "processj.showProcedureEffects",
        "title": "Show Procedure Effects",
        "category": "ProcessJ",
        "icon": "$(pulse)",
        "enablement": "editorLangId == processj"
      },
      {
        "command": "processj.convertCurrentFileToCsp",
        "title": "Convert to CSP",
        "category": "ProcessJ",
        "icon": "$(file-code)",
        "enablement": "editorLangId == processj"
      },
      {
        "command": "processj.checkCurrentFileWithFdr",
        "title": "Check with FDR",
        "category": "ProcessJ",
        "icon": "$(debug-alt)",
        "enablement": "editorLangId == processj || editorLangId == cspm"
      },
      {
        "command": "processj.cancelFdrCheck",
        "title": "Cancel FDR Check",
        "category": "ProcessJ",
        "icon": "$(debug-stop)"
      },
      {
        "command": "processj.restartServer",
        "title": "Restart Language Server",
        "category": "ProcessJ",
        "icon": "$(debug-restart)"
      },
      {
        "command": "processj.showOutput",
        "title": "Show Language Server Output",
        "category": "ProcessJ",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "processj.runCurrentFile",
          "when": "editorLangId == processj",
          "group": "navigation@1"
        },
        {
          "command": "processj.showConcurrencyGraph",
          "when": "editorLangId == processj || editorLangId == cspm",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "processj.showConcurrencyGraph",
          "when": "editorLangId == processj || editorLangId == cspm",
          "group": "navigation@10"
        },
        {
          "command": "processj.exportConcurrencyGraphFiles",
          "when": "editorLangId == processj || editorLangId == cspm",
          "group": "navigation@10"
        },
        {
          "command": "processj.showProtocolFlow",
          "when": "editorLangId == processj",
          "group": "navigation@11"
        },
        {
          "command": "processj.showProcedureEffects",
          "when": "editorLangId == processj",
          "group": "navigation@12"
        },
        {
          "command": "processj.convertCurrentFileToCsp",
          "when": "editorLangId == processj",
          "group": "navigation@13"
        },
        {
          "command": "processj.checkCurrentFileWithFdr",
          "when": "editorLangId == processj || editorLangId == cspm",
          "group": "navigation@14"
        }
      ]
    },
    "semanticTokenScopes": [
      { "scopes": { "variable.channelRead:processj": ["variable.other.readwrite.processj"], "parameter.channelRead:processj": ["variable.parameter.read.processj"], "property.channelRead:processj": ["variable.other.property.read.processj"], "variable.channelWrite:processj": ["variable.other.write.processj"], "parameter.channelWrite:processj": ["variable.parameter.write.processj"], "property.channelWrite:processj": ["variable.other.property.write.processj"], "variable.channelShared:processj": ["variable.other.shared.processj"], "parameter.channelShared:processj": ["variable.parameter.shared.processj"], "property.channelShared:processj": ["variable.other.property.shared.processj"] } }
    ],
    "configuration": {
      "title": "ProcessJ",
      "properties": {
        "processj.installDir": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "ProcessJ install directory (with bin/ and resources/jars). Empty: use installdir from ~/processjrc or $PROCESSJ_HOME. Changes restart the server automatically."
        },
        "processj.javaBin": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Java executable used for compiler diagnostics and Run. Empty: use $JAVA_HOME/bin/java or java on PATH."
        },
        "processj.checkOnChange": {
          "type": "boolean",
          "default": false,
          "description": "Also run the real compiler on every edit (default: only on open and save; the built-in checker runs as you type)."
        },
        "processj.lint": {
          "type": "boolean",
          "default": true,
          "description": "Run the built-in type checker and concurrency lints."
        },
        "processj.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show inline Run, Build, effect, concurrency-graph, protocol-summary and FDR code lenses. Commands remain available from the editor title and Command Palette when disabled."
        },
        "processj.liveViewer": {
          "type": "boolean",
          "default": true,
          "description": "When the concurrency graph is opened in a browser (Neovim, Emacs, or the server command), serve it from a loopback-only local page that follows edits and new verification results. Off: write a self-contained HTML file instead. VS Code's own panel is not affected."
        },
        "processj.debounceMs": {
          "type": "integer",
          "default": 400,
          "minimum": 0,
          "maximum": 60000,
          "description": "Milliseconds to wait after the last edit before starting a compiler check when checkOnChange is enabled."
        },
        "processj.timeoutMs": {
          "type": "integer",
          "default": 20000,
          "minimum": 100,
          "maximum": 600000,
          "description": "Maximum duration in milliseconds for one compiler diagnostic run."
        },
        "processj.runTimeoutMs": {
          "type": "integer",
          "default": 30000,
          "minimum": 100,
          "maximum": 3600000,
          "description": "Maximum duration in milliseconds for a program launched with ProcessJ: Run Current File."
        },
        "processj.fdrPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "FDR's refines executable (or FDR's install directory) for ProcessJ: Check with FDR. Empty: $FDR_REFINES, $FDR_HOME, PATH, then /Applications/FDR4.app/Contents/MacOS/refines and the usual install locations. Get FDR at https://cocotec.io/fdr/."
        },
        "processj.fdrTimeoutMs": {
          "type": "integer",
          "default": 120000,
          "minimum": 1000,
          "maximum": 3600000,
          "description": "Maximum duration in milliseconds for one FDR check."
        },
        "processj.fdrMemoryMb": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 1048576,
          "description": "Stop an FDR check once refines uses more than this many megabytes (a big model can take tens of gigabytes within seconds). 0: half of this machine's memory, at most 8 GB."
        },
        "processj.fdrWorkers": {
          "type": "integer",
          "default": 1,
          "minimum": 0,
          "maximum": 1024,
          "description": "Workers FDR's search uses. 1 (the default) finds the same deadlock and runtime-error counterexamples every time you check (a termination or determinism counterexample can still differ); 0 uses every core, faster on big models but any counterexample may differ from one check to the next."
        },
        "processj.fdrShowGraph": {
          "type": "string",
          "enum": [
            "always",
            "onFailure",
            "never"
          ],
          "enumDescriptions": [
            "Open the graph on the result after every check (the default).",
            "Open the graph on the result only when a check fails, finds a partial deadlock or a runtime error; otherwise open the text report.",
            "Never open the graph: open the text report instead."
          ],
          "default": "always",
          "description": "After ProcessJ: Check with FDR, open the concurrency graph panel on the result, with the stuck processes and the run that leads there marked. The text report (.pjreport) is always written, and opened when the graph is not."
        },
        "processj.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path to processj-lsp.js (a leading ~ is supported). Empty: use the bundled server. Changes restart the language client automatically."
        },
        "processj.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace messages exchanged with the ProcessJ language server in the ProcessJ Language Server Trace output channel."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "package": "node scripts/build.js && vsce package --no-dependencies",
    "install-extension": "node scripts/build.js && vsce package --no-dependencies --out processj.vsix && code --install-extension processj.vsix --force"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.9.0",
    "esbuild": "^0.25.0"
  }
}
