// expect: pj/needs-yield-annotation
import std.*;

public void wait1() { timer t; t.timeout(t.read() + 1); }

// `twice` never communicates itself, only through what it calls, so it must be
// marked [yield=true] to be compiled as a suspending process (the compiler
// always treats `main` as one). The quick fix adds the annotation; Run applies
// it automatically.
public void twice() { wait1(); wait1(); }

public void main(string[] args) { twice(); println("ok"); }
