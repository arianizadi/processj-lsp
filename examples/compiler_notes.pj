// expect: none
// notes: pj/note-narrow-literal, pj/note-semicolon-string, pj/note-par-gc, pj/note-par-loop-calls, pj/note-par-gc, pj/note-ignored-statement, pj/note-ignored-statement
import std.*;

// Everything here builds and runs, but this ProcessJ build gets it subtly wrong.
// Each line gets an information-level note (pj/note-*) rather than a warning.
public void worker(int i, chan<int>.write out) { out.write(i); }

public void main(string[] args) {
    shared chan<int> c;
    byte small = 1;                      // the compiler prints a spurious "cannot assign int to byte"; it still builds
    println("a;b");                      // prints "ab": ';' is stripped from string literals
    par {                                // a par can end early: a finished branch is counted twice at the next GC
        for (int i = 0; i < 3; i++) worker(i, c.write);   // and a loop of suspending calls ends it early for sure
        for (int j = 0; j < 3; j++) println("got " + c.read());
    }
    par for (int k = 0; k < 2; k++) println("k " + k + " " + small);
    suspend;                             // ignored
    println("done");
    stop;                                // ignored: the process ends normally
}
