-- A barrier as the ProcessJ runtime implements it (PJBarrier): a counter of enrolled and waiting
-- processes. A sync completes when the last enrolled process arrives; a terminating branch resigns,
-- but resigning never completes a barrier, so processes already waiting stay blocked.
-- (n: enrolled, w: waiting, mx: a bound on both, so FDR can compile the counter on its own.)
PJ_BAR(pj_b, pj_mx) = PJ_BAR_S(pj_b, pj_mx, 1, 0)
PJ_BAR_S(pj_b, pj_mx, pj_n, pj_w) =
     pj_b.pj_sync -> (if pj_w + 1 == pj_n then PJ_BAR_R(pj_b, pj_mx, pj_n, pj_w + 1) else if pj_w + 1 < pj_mx then PJ_BAR_S(pj_b, pj_mx, pj_n, pj_w + 1) else STOP)
  [] pj_b.pj_resign -> PJ_BAR_S(pj_b, pj_mx, if pj_n > 1 then pj_n - 1 else pj_n, pj_w)
  [] ([] (pj_e, pj_m) : {(pj_x, pj_y) | (pj_x, pj_y) <- PJ_ENROLLS, pj_y <= pj_mx, pj_n + pj_y - 1 >= 0, pj_n + pj_y - 1 <= pj_mx} @ pj_b.pj_e -> PJ_BAR_S(pj_b, pj_mx, pj_n + pj_m - 1, pj_w))
  [] pj_end -> STOP
PJ_BAR_R(pj_b, pj_mx, pj_n, pj_r) = if pj_r == 0 then PJ_BAR_S(pj_b, pj_mx, pj_n, 0) else pj_b.pj_go -> PJ_BAR_R(pj_b, pj_mx, pj_n, pj_r - 1)
-- A mediated channel (several processes on both of its sides): a server takes one written value,
-- hands it to one reader, waits for the reader to finish and releases the writer. Same rendezvous,
-- but writers and readers never synchronise with each other directly.
PJ_MED(pj_c, pj_t, pj_d, pj_a) = (pj_c?pj_v -> pj_t!pj_v -> pj_d -> pj_a -> PJ_MED(pj_c, pj_t, pj_d, pj_a)) [] (pj_end -> STOP)

