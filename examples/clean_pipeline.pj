// expect: none
import std.*;

const int N = 5;

// A three-stage pipeline: correct ProcessJ that produces no diagnostics and
// terminates. Use the Run code lens to execute it.
public void producer(chan<int>.write out) {
    for (int i = 1; i <= N; i++) out.write(i);
}

public void squarer(chan<int>.read in, chan<int>.write out) {
    for (int i = 0; i < N; i++) {
        int v = in.read();
        out.write(v * v);
    }
}

public void consumer(chan<int>.read in) {
    int sum = 0;
    for (int i = 0; i < N; i++) sum = sum + in.read();
    println("sum of squares: " + sum);
}

public void main(string[] args) {
    chan<int> a;
    chan<int> b;
    par {
        producer(a.write);
        squarer(a.read, b.write);
        consumer(b.read);
    }
}
