// expect: pj/short-circuit-read
import std.*;

public void source(chan<int>.write out) { out.write(1); }

// The compiler hoists `c.read()` out of the expression and performs it before
// evaluating `n > 0`, so this read happens even when n is 0 and blocks forever.
public void main(string[] args) {
    chan<int> c;
    int n = 0;
    par {
        source(c.write);
        if (n > 0 && c.read() == 1) println("one");
    }
}
