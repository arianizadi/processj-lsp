// A small program whose -showTree dump is recorded next to it (shapes.tree),
// so the harness in scripts/parse-diff.js can be checked without a compiler.
import std.*;
const int N = 2, M;
record R extends Base { int a, b[]; }
protocol P { t: { int x; } u: { } }

public void f(chan<int>.read c, shared chan<chan<int> >.write d, timer t, R r, int[] v) [yield=true] {
    int x = (int) -1 + 2 * 3 << 1, y[] = { 1, +2 };
    x = x > 0 ? r.a : (x) - 1;
    x += (R) r.b[0] - ((R)) v.length;
    if (x is t == true) if (y[0] < 2) x++; else --x;
    for (int i = 0; i < N; i++, x >>>= i) c.read();
    par for (; ; ) enroll (b) d.write(c.read({ x = 1; }));
    alt { (x > 0) && x = c.read() : skip; t.timeout(5) : ; skip : stop; }
    L: while (true) { break L; continue; }
    switch (x) { case 1: case 2: x = 1; default: ; }
    claim (d) { d.write(new P { t: x = 1 }); }
    par enroll b, e { seq { return; } }
    R s = new R { a = 1, b = new int[2][] };
    lib::g(fork(x), std.lib::h);
}
