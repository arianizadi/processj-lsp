pj_abs(pj_x) = if pj_x < 0 then -pj_x else pj_x
pj_div(pj_a, pj_b) = let pj_q = pj_abs(pj_a) / pj_abs(pj_b) within if (pj_a < 0) == (pj_b < 0) then pj_q else -pj_q
