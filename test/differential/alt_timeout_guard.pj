// outcome: runs
import std.*;
// A timer read inside an alt timeout guard builds and runs with this compiler
// (since commit 179847f, "Fix: Timer reads in channel guards"): "read 1".
public void main(string[] args) {
    chan<int> c;
    timer t;
    int x;
    par {
        c.write(1);
        alt {
            x = c.read() : { println("read " + x); }
            t.timeout(t.read() + 1000) : { println("late"); }
        }
    }
}
