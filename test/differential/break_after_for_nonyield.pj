// outcome: runs
import std.*;
public void work() {
    int k = 0;
    while (true) {
        int s = 0;
        for (int i = 0; i < 3; i++) { s = s + i; }
        k = k + s;
        if (k > 5) break;
    }
    println("k " + k);
}
public void main(string[] args) {
    work();
    println("after");
}
