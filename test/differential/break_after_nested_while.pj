// outcome: runs
import std.*;
public void consumer(chan<int>.read in) {
    int k = 0;
    while (true) {
        int s = 0;
        while (s < 3) { s++; }
        k = k + in.read();
        if (k > 5) break;
    }
    println("k " + k);
}
public void producer(chan<int>.write out) {
    for (int i = 1; i <= 3; i++) out.write(i);
    println("producer done");
}
public void main(string[] args) {
    chan<int> c;
    par { producer(c.write); consumer(c.read); }
    println("after par");
}
