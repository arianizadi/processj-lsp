// outcome: runs-wrong
import std.*;
public void consumer(chan<int>.read in) {
    int k = 0; int n = 0;
    while (n < 6) {
        n++;
        int s = 0;
        for (int i = 0; i < 2; i++) { s = s + i; }
        int v = in.read();
        if (v % 2 == 0) continue;
        k = k + v;
    }
    println("k " + k);
}
public void producer(chan<int>.write out) {
    for (int i = 1; i <= 6; i++) out.write(i);
}
public void main(string[] args) {
    chan<int> c;
    par { producer(c.write); consumer(c.read); }
    println("after par");
}
